# NyaaVoiceBridge 环境变量覆盖配置样例 (可选)
# 如果您不想直接修改 config/config.yaml，可在根目录下创建 .env 文件配置如下敏感字段：

# 蓝牙音频节点
NYAA_BT_INPUT_NODE=bluez_input.00_00_00_00_00_00.0
NYAA_BT_OUTPUT_NODE=bluez_output.00_00_00_00_00_00.1

# SenseVoice STT 地址
NYAA_STT_API_URL=http://127.0.0.1:5052/v1/audio/transcriptions

# AstrBot WebSocket 与用户绑定 ID
NYAA_ASTRBOT_WS_URL=ws://127.0.0.1:6199/ws
NYAA_ASTRBOT_USER_ID=10001
